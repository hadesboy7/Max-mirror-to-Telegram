# ═══════════════════════════════════════════════════════════════════
#  MAX Mirror — пример настроек. Скопируйте в .env и заполните.
#      cp .env.example .env
#  Файл .env в репозиторий не попадает (см. .gitignore).
# ═══════════════════════════════════════════════════════════════════

# ─── Telegram: обязательное ────────────────────────────────────────

# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=123456789:ЗАМЕНИТЕ_НА_СВОЙ_ТОКЕН

# КУДА пересылать сообщения. Один или несколько id через запятую.
# Личный чат — положительное число, группа или канал — отрицательное.
# Узнать id: напишите боту @userinfobot (личный) либо добавьте его в группу.
# Бот должен быть участником группы или канала.
#   один чат:   TELEGRAM_TARGET_CHAT_IDS=123456789
#   несколько:  TELEGRAM_TARGET_CHAT_IDS=123456789,-1001111111111,-1002222222222
TELEGRAM_TARGET_CHAT_IDS=123456789

# КТО может управлять ботом: кнопка «Скриншот чата», команда /start.
# ЭТО ОТДЕЛЬНЫЙ СПИСОК от получателей выше. Участник целевого чата
# НЕ получает управление ботом автоматически.
# Пусто = управление запрещено всем (безопасное поведение по умолчанию).
TELEGRAM_ALLOWED_USER_IDS=123456789

# ─── MAX: обязательное ─────────────────────────────────────────────

# Адрес КОНКРЕТНОЙ беседы. Откройте её в web.max.ru и скопируйте адрес.
MAX_URL=https://web.max.ru/-70000000000000

# Каталог профиля браузера. Здесь хранится вход в MAX после сканирования QR.
# НЕ удаляйте и НЕ публикуйте этот каталог.
USER_DATA_DIR=./max_profile

# ─── Режим работы ──────────────────────────────────────────────────

# 0 = фоновый режим без окна браузера (для сервера).
# 1 = с окном — нужно один раз, чтобы отсканировать QR.
HEADFUL=0

# Как часто читать беседу, секунды.
POLL_SEC=2

# Пересылать правки и удаления сообщений.
TRACK_EDITS=1
TRACK_DELETES=1

# Запись ИЗ Telegram В беседу MAX. Выключено по умолчанию.
# Эта возможность реализована, но слабо проверена — включайте осознанно.
SEND_TO_MAX=0

# Подпись при записи в беседу (нужна только при SEND_TO_MAX=1): "id=Имя,id=Имя"
SIGN_MAP=

# ─── Необязательное: лимиты и надёжность ───────────────────────────

# Максимальный размер одного вложения, байты (по умолчанию 20 МБ).
# MEDIA_MAX_BYTES=20971520

# Бюджет памяти на один альбом фотографий, байты (40 МБ).
# ALBUM_MAX_BYTES=41943040

# Как часто писать в журнал отметку «жив», секунды.
# HEARTBEAT_SEC=1800

# Таймаут операции с браузером, секунды. Превышение = перезапуск моста.
# PAGE_OP_TIMEOUT=45

# Сколько отправок делать за один цикл и сколько секунд на них тратить.
# DELIVER_BATCH=10
# DELIVER_BUDGET_SEC=2

# Контрольное окно первого запуска. 0 = чистый старт без дубликатов.
# Значение 1-3 нужно ТОЛЬКО при переходе с уже работающего моста:
# оно пересылает последние N сегодняшних сообщений, чтобы не потерять
# пришедшие в момент переключения. Ценой нескольких дубликатов.
# BOOTSTRAP_RESEND_LAST=0

# Путь к базе состояния. Внутри — очередь доставки и защита от дубликатов.
# STATE_DB=./state.db

# ─── Селекторы веб-клиента MAX ─────────────────────────────────────
# Заданы по умолчанию в коде. Менять нужно только если MAX изменит вёрстку
# и мост перестанет видеть сообщения (см. docs/TROUBLESHOOTING.md).
# SEL_MSG_ITEM=.bubbleContent
# SEL_MSG_AUTHOR=.header .name
# SEL_MSG_TEXT=:scope > span.text
# SEL_MSG_TIME=.meta
# SEL_COMPOSER=[data-lexical-editor='true']

# ─── Аргументы Chromium ────────────────────────────────────────────
# На сервере под root обязателен --no-sandbox.
# ВАЖНО: не добавляйте свои --enable-features или --blink-settings —
# они затирают настройки Playwright и ломают скриншоты и селекторы.
CHROMIUM_ARGS=--no-sandbox --disable-dev-shm-usage --disable-gpu --disable-extensions --disable-background-networking
